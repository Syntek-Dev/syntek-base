# Production environment template.
#
# Production secrets are managed on the server — a committed .env is never the
# source of truth. This file documents the required keys and nothing more.
# Postgres and Valkey run on the server host, not in this compose stack.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me
DEBUG=false

# Comma-separated. Must list every hostname the site answers on.
ALLOWED_HOSTS=<%PRIMARY_DOMAIN%>,www.<%PRIMARY_DOMAIN%>
CSRF_TRUSTED_ORIGINS=https://<%PRIMARY_DOMAIN%>,https://www.<%PRIMARY_DOMAIN%>

# Django's built-in admin mount. Never /admin/ — see code/docs/URL-STRATEGY.md.
DJANGO_ADMIN_PATH=control/

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<%PROJECT_SLUG%>:change_me@127.0.0.1:5432/<%PROJECT_SLUG%>_prod
REDIS_URL=redis://127.0.0.1:6379/0

# ── Deployment ────────────────────────────────────────────────────────────────
IMAGE_TAG=prod

# ── Gunicorn tuning ───────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
