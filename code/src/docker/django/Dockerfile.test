FROM python:3.14-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libmagic1 \
    libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# uv is pinned to the version CI runs (claude.yml UV_VERSION); toolchain-pins.sh holds them in step.
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/workspace/.venv/bin:$PATH"

WORKDIR /workspace

COPY pyproject.toml uv.lock ./
# --frozen, like every other image: the test image is built from the COMMITTED lock and
# fails loudly if pyproject.toml and uv.lock disagree, rather than resolving fresh. It was
# disabled until the test group was locked; uv.lock has carried it since 16/08/2026.
RUN uv sync --frozen --no-install-project --group test

# Bake source into image — no volume mounts in test
COPY code/src/django/ ./code/src/django/

COPY code/src/docker/django/entrypoint.test.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
