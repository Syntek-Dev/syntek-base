# Development environment template.
#
# Copy to .env.dev and fill in. NEVER commit .env.dev — only this .example file.
#   cp code/src/docker/.env.dev.example code/src/docker/.env.dev
#
# Generate a secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# ── Database ──────────────────────────────────────────────────────────────────
# POSTGRES_DB is fixed to {{PROJECT_SLUG}}_dev by the compose file.
POSTGRES_USER={{PROJECT_SLUG}}
POSTGRES_PASSWORD=change_me

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me
DEBUG=true

# Django's built-in admin mount. Never /admin/ — see code/docs/URL-STRATEGY.md.
DJANGO_ADMIN_PATH=control/

# ── Seeding (optional — used by database/seed-dev.sh) ─────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change_me

SEED_STAFF_USERNAME=staff
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=change_me

# Space-separated manage.py commands seed-dev.sh runs after the users, in
# dependency order. Empty at baseline — the project has no apps and so no seed
# commands. e.g. SEED_COMMANDS="seed_tags seed_articles"
SEED_COMMANDS=
