# Worktree isolation override — test stack. TEMPLATE: copy, never edit in place.
#
# Replace NNN with the story number throughout (e.g. story 3 → us003, 127.0.0.3, 10.3.0.0/24).
# Save as docker-compose.us<NNN>.test.yml; the test scripts auto-detect it on a us<NNN>/* branch.
#
# Usage (manual):
#   docker compose \
#     -f code/src/docker/docker-compose.test.yml \
#     -f code/src/docker/docker-compose.usNNN.test.yml \
#     --env-file code/src/docker/.env.test \
#     up -d
#
# Container names: {{PROJECT_SLUG}}-test-usNNN-*-1
# Named volumes:   {{PROJECT_SLUG}}-test-usNNN_staticfiles_test
# Test URL:        http://test-usNNN.{{PROJECT_SLUG}}.localhost:3081
#
# /etc/hosts required (one-time):
#   127.0.0.NNN test-usNNN.{{PROJECT_SLUG}}.localhost

name: {{PROJECT_SLUG}}-test-usNNN

services:
  nginx:
    ports: !override
      - "127.0.0.NNN:3081:80"

networks:
  default:
    driver: bridge
    ipam:
      config:
        # Third octet 0 = test, 1 = dev. Second octet = story number.
        - subnet: 10.NNN.0.0/24
          gateway: 10.NNN.0.1
