# Staging environment template.
#
# Copy to .env.staging on the server and fill in. NEVER commit .env.staging.
# Postgres and Valkey run on the server host, not in this compose stack, so the
# URLs below point at the host rather than a compose service name.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me
DEBUG=false

# Comma-separated. Must list every hostname the site answers on.
ALLOWED_HOSTS=staging.{{PRIMARY_DOMAIN}}
CSRF_TRUSTED_ORIGINS=https://staging.{{PRIMARY_DOMAIN}}

# Django's built-in admin mount. Never /admin/ — see code/docs/URL-STRATEGY.md.
DJANGO_ADMIN_PATH=control/

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://{{PROJECT_SLUG}}:change_me@127.0.0.1:5432/{{PROJECT_SLUG}}_staging
REDIS_URL=redis://127.0.0.1:6379/0

# ── Deployment ────────────────────────────────────────────────────────────────
IMAGE_TAG=staging

# ── Gunicorn tuning ───────────────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
