# Test environment template.
#
# Copy to .env.test and fill in. NEVER commit .env.test — only this .example file.
#   cp code/src/docker/.env.test.example code/src/docker/.env.test
#
# Every value here has a working default in docker-compose.test.yml, so the test stack
# runs without a .env.test at all. Override only what you need.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER={{PROJECT_SLUG}}
POSTGRES_PASSWORD=test_password_change_me

# ── Django ────────────────────────────────────────────────────────────────────
# Not a real secret — the test database and cache never leave the runner.
SECRET_KEY=test-secret-key-not-for-production
DEBUG=false
