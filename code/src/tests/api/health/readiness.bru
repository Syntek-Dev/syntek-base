meta {
  name: Readiness (Dependency Aggregate)
  type: http
  seq: 2
}

get {
  url: {{api_url}}/health/ready/
  body: none
  auth: none
}

tests {
  test("Status is 200 or 503, and nothing else", function() {
    expect([200, 503]).to.include(res.getStatus());
  });

  test("Body carries status and nothing else", function() {
    expect(Object.keys(res.getBody())).to.eql(["status"]);
  });

  test("Status is one of the three contracted words", function() {
    expect(["operational", "degraded", "down"]).to.include(res.getBody().status);
  });

  test("503 accompanies down, and only down", function() {
    if (res.getStatus() === 503) {
      expect(res.getBody().status).to.equal("down");
    } else {
      expect(res.getBody().status).to.not.equal("down");
    }
  });

  test("Stack under test is operational", function() {
    expect(res.getBody().status).to.equal("operational");
  });

  test("Never cached", function() {
    expect(res.getHeader("cache-control")).to.contain("no-cache");
  });
}
