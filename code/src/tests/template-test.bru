##
## Bruno Test Template — Django Ninja REST
##
## Copy this file into the request's folder under api/ and rename it kebab-case.
##
## `health/` is the only folder at baseline: the Django project serves no API yet.
## Domain folders appear beside it one per domain (`auth/`, `users/`, …) as endpoints
## ship, each carrying its own CONTEXT.md + CLAUDE.md pair — see api/CONTEXT.md for
## the procedure, which owns it. Nothing here restates that.
##
## Remove the comment blocks and every unused section before committing. This file
## itself is never run: it sits OUTSIDE api/, so the CLI never collects it.
##

meta {
  ##
  ## name:  Short, descriptive test name (shown in the CI build log).
  ##        Convention: "<Action> (<Context>)" e.g. "Login (Valid Credentials)"
  ## type:  Always "http".
  ## seq:   Execution order within this folder (1, 2, 3...).
  ##        Folders run alphabetically, requests by seq within the folder.
  ##
  name: <Your Test Name Here>
  type: http
  seq: 1
}

##
## The verb block is named for the method: get, post, put, patch or delete.
## Every request targets {{api_url}}/api/ bar the health probes, which are plain
## Django views at the root. auth: "bearer" for authenticated calls, "none" for public.
##
post {
  url: {{api_url}}/api/<your-resource>/
  body: json
  auth: bearer
}

auth:bearer {
  ##
  ## {{auth_token}} is set by the login request via bru.setVar, so that request must
  ## run first. The environments declare api_url, timeout_ms and slow_threshold_ms;
  ## anything else you reference has to be set by an earlier request or added there —
  ## an undeclared variable fails at resolution, before the request is ever sent.
  ##
  token: {{auth_token}}
}

##
## REQUEST BODY — the endpoint's InSchema, as JSON. Delete this block for GET.
##
body:json {
  {
    "field": "value"
  }
}

##
## ASSERTIONS (tests block)
## Bruno uses Chai.js assertion syntax: https://www.chaijs.com/api/bdd/
##
## REST returns a real status code, so assert the one the endpoint contracts for —
## never a blanket 200. A success response IS its OutSchema: there is no {"data": …}
## wrapper. An error response is always the envelope owned by
## code/docs/api-design/AUTH-AND-ERRORS.md — {"error": {"code", "message", "details"}} —
## and error.code is lowercase snake_case.
##
## Thresholds, from the environment rather than hardcoded:
##   - Standard reads:      < 500ms
##   - Complex/paginated:   < 2000ms
##   - Expensive:           {{slow_threshold_ms}}
##
tests {
  test("Status is the contracted one", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Body is the OutSchema, unwrapped", function() {
    expect(res.getBody()).to.have.property("id");
    expect(res.getBody()).to.not.have.property("data");
  });

  test("X-Request-ID is present on every response", function() {
    expect(res.getHeader("x-request-id")).to.be.a("string");
  });

  test("Response time < 500ms", function() {
    expect(res.getResponseTime()).to.be.below(500);
  });
}

##
## The failure path is a test, not an afterthought — an endpoint that cannot be made to
## fail correctly has not been tested. Put it in its own .bru file beside this one:
##
##   test("Rejection carries the error envelope", function() {
##     expect(res.getStatus()).to.equal(422);
##     expect(res.getBody().error).to.have.all.keys("code", "message", "details");
##     expect(res.getBody().error.code).to.match(/^[a-z0-9_]+$/);
##   });
##
