{
  "lsp": {
    "vscode-css-language-server": {
      "initialization_options": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore"
          }
        }
      }
    }
  },
  "private_files": [
    "**/.env*",
    "**/.env.dev",
    "**/.env.test",
    "**/.env.testing",
    "**/.env.staging",
    "**/.env.prod",
    "**/.env.production",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml"
  ]
}
