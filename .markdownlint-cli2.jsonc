{
  "globs": [
    "**/*.md",
    "!.agents/**",
    "!code/docs/cloudinary/**",
    "!.claude/**",
    ".claude/CLAUDE.md",
    "!.venv/**",
    "!node_modules/**",
    "!**/node_modules/**",
    "!.next/**",
    "!coverage/**",
    "!htmlcov/**",
    "!**/staticfiles/**",
    "!**/tests/e2e/results/**",
    "!**/tests/e2e/playwright-report/**",
    "!project-management/export/**",
    "!code/docs/MACHINE-SPEC.md",
    "!code/src/scripts/**/reports/**",
    "!code/src/rust/target/**",
  ],
  // Always-applied ignores (honoured even when files are passed as CLI args, e.g. by
  // lefthook). Generated ClickUp client exports, the host-specific machine spec, and the
  // audit/test report output are auto-generated and must not be linted — an audit run with
  // `--output md` would otherwise fail the lint gate it exists to complement.
  "ignores": [
    "project-management/export/**",
    "code/docs/MACHINE-SPEC.md",
    "code/src/scripts/**/reports/**",
    "code/src/rust/target/**",
  ],
  "config": {
    "default": true,
    // Line-length limit: disabled — tables and code examples routinely exceed 100 chars
    "MD013": false,
    // Duplicate headings: disabled — technical reference docs repeat "Rules" subsections by design
    "MD024": false,
    // Blank line in blockquote: disabled — two consecutive blockquotes appear in several docs
    "MD028": false,
    // Inline HTML: disabled — used intentionally in some docs
    "MD033": false,
    // Bare URLs: disabled — localhost dev URLs appear in how-to docs and are intentional
    "MD034": false,
    // Emphasis as heading: disabled — bold phrases used as section labels in principles docs
    "MD036": false,
    // First line must be heading: disabled — some docs start with metadata or a lead paragraph
    "MD041": false,
    // Single H1: treat YAML front-matter title field as blank so the document-level # heading
    // is the sole H1; API design docs carry both a YAML `title:` key and a # heading by design
    "MD025": { "front_matter_title": "" },
    // Ordered list prefix: allow sequential (1, 2, 3) — code blocks between items interrupt
    // the list context and would otherwise require all items to use "1."
    "MD029": { "style": "ordered" },
    // Fenced code language: kept enabled — required by CLAUDE.md
    "MD040": true,
  },
}
